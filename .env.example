DJANGO_SECRET_KEY=altere-isso-em-producao
DJANGO_DEBUG=false
# Local: localhost. Railway: inclua o domínio público (ou confie no wildcard .up.railway.app no settings)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backendcn-dev.up.railway.app
# Admin/login POST — origins com esquema (obrigatório no Django 4+)
DJANGO_CSRF_TRUSTED_ORIGINS=https://backendcn-dev.up.railway.app,http://localhost:8000,http://127.0.0.1:8000
# Railway: use o Postgres do projeto — DATABASE_URL é injetada automaticamente
# DATABASE_URL=postgres://...

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://frontendcn-dev.up.railway.app

# Porta do Gunicorn (Railway define PORT)
PORT=8000

# Superusuário (comando createsuperuser --noinput)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@playhub.local
DJANGO_SUPERUSER_PASSWORD=PlayHub@Admin2026
# Uma vez no Railway, se o login falhar, defina true, redeploy, depois volte para false:
# DJANGO_SUPERUSER_RESET_PASSWORD=true
